---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Nav from '../../components/Nav.astro';
import Layout from '../../layouts/Layout.astro';

const allDocs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const categories = new Map<string, typeof allDocs>();
allDocs.forEach((doc) => {
  const group = categories.get(doc.data.category) ?? [];
  group.push(doc);
  categories.set(doc.data.category, group);
});
---

<Layout title="文档" description="EagleCoder 的学习文档与参考手册">
  <Nav />

  <main id="main-content" class="archive-page">
    <header class="site-container archive-header">
      <p class="eyebrow"><span>03 / LIBRARY</span><span>{allDocs.length} DOCUMENTS</span></p>
      <div class="archive-title-row">
        <h1>学习文档与<br /><em>参考手册</em></h1>
        <p>把零散笔记整理成能再次使用的知识：短、清楚，并保留足够的上下文。</p>
      </div>
    </header>

    <section class="site-container archive-content" aria-labelledby="docs-list-title">
      <div class="filter-bar">
        <h2 id="docs-list-title">文档目录</h2>
        <p>{categories.size} 个分类</p>
      </div>

      {allDocs.length > 0 ? (
        <div class="docs-catalog">
          {[...categories.entries()].map(([category, docs], categoryIndex) => (
            <section class="doc-category">
              <header>
                <span>{String(categoryIndex + 1).padStart(2, '0')}</span>
                <h3>{category}</h3>
                <small>{docs.length} 篇</small>
              </header>
              <div>
                {docs.map((doc, docIndex) => (
                  <a href={`/docs/${doc.id}`}>
                    <span>{String(docIndex + 1).padStart(2, '0')}</span>
                    <strong>{doc.data.title}</strong>
                    <p>{doc.data.description ?? '打开文档阅读全文'}</p>
                    <b aria-hidden="true">→</b>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <p class="empty-state">第一份文档正在整理。</p>
      )}
    </section>
  </main>

  <Footer />
</Layout>
