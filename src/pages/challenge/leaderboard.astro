---
// /challenge/leaderboard — 排行榜
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="排行榜" description="每日一题排行榜">
  <Nav />

  <main id="main-content" class="interactive-page challenge-archive-page" data-pagefind-ignore>
    <header class="site-container interactive-header">
      <p class="eyebrow"><span>04 / DAILY CHALLENGE</span><span>SCOREBOARD</span></p>
      <div>
        <h1>让每次提交，<br /><em>留下刻度。</em></h1>
        <div class="challenge-header-side">
          <p>汇总每位挑战者的最高成绩。排名是阶段性的，更重要的是下一次提交比上一次更清楚。</p>
          <nav aria-label="排行榜辅助导航">
            <a href="/challenge">今日题目</a>
            <a href="/challenge/history">历史题目</a>
          </nav>
        </div>
      </div>
    </header>

    <section class="site-container leaderboard-stage" aria-labelledby="leaderboard-title">
      <div class="leaderboard-toolbar">
        <div>
          <span>LIVE RANKING</span>
          <h2 id="leaderboard-title">成绩榜</h2>
        </div>
        <div class="leaderboard-tabs" id="tabs" role="tablist" aria-label="排行榜范围">
          <button class="tab-btn active" data-tab="total" type="button" role="tab" aria-selected="true">总分排行</button>
          <button class="tab-btn" data-tab="today" type="button" role="tab" aria-selected="false">今日题目</button>
        </div>
      </div>

      <div id="leaderboard-container" class="leaderboard-container" aria-live="polite">
        <p class="leaderboard-state">正在读取成绩…</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  (function() {
    const container = document.getElementById('leaderboard-container');
    const tabs = document.querySelectorAll('.tab-btn');
    if (!container) return;

    let currentTab = 'total';

    // 获取今日题目 ID（从 challenge 数据接口）
    async function getTodayId() {
      try {
        const res = await fetch('/api/challenge/today');
        const data = await res.json();
        return data.id;
      } catch { return null; }
    }

    async function load(tab) {
      container.innerHTML = '<p class="leaderboard-state">正在读取成绩…</p>';
      try {
        let url = '/api/stats/leaderboard?limit=20';
        if (tab === 'today') {
          const id = await getTodayId();
          if (id) url += '&challenge_id=' + id;
        }
        const res = await fetch(url);
        const data = await res.json();
        const list = data.leaderboard || [];

        if (!list.length) {
          container.innerHTML = '<p class="leaderboard-state">还没有提交记录。去完成第一次打卡吧。</p>';
          return;
        }

        let html = `<div class="leaderboard-table-wrap">
          <table class="leaderboard-table">
            <thead><tr>
              <th>#</th>
              <th>用户</th>
              <th>总分</th>
              <th>通过</th>
              <th>题数</th>
              <th>最近提交</th>
            </tr></thead><tbody>`;

        const medals = ['🥇','🥈','🥉'];
        list.forEach((r, i) => {
          const rowClass = i < 3 ? 'rank-top' : (i % 2 === 0 ? 'rank-alt' : '');
          html += `<tr class="${rowClass}">
            <td>${medals[i] || String(i + 1).padStart(2, '0')}</td>
            <td><strong>${escapeHtml(r.username)}</strong></td>
            <td><b>${r.total_score}</b></td>
            <td>${r.total_passed || 0}</td>
            <td>${r.solutions || 0}</td>
            <td><time>${formatDate(r.last_submit)}</time></td>
          </tr>`;
        });
        html += '</tbody></table></div>';
        container.innerHTML = html;
      } catch (e) {
        container.innerHTML = '<p class="leaderboard-state is-error">加载失败，请稍后重试。</p>';
      }
    }

    function escapeHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function formatDate(d) { if (!d) return '-'; const t = new Date(d); return t.toLocaleDateString('zh-CN') + ' ' + t.toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'}); }

    // Tab 切换
    tabs.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tab = btn.getAttribute('data-tab');
        if (tab === currentTab) return;
        currentTab = tab;
        tabs.forEach(function(b) {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        load(tab);
      });
    });

    load(currentTab);
  })();
</script>
