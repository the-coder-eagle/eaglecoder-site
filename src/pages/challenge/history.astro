---
// /challenge/history — 历史题目列表
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import { challenges, type Challenge } from '../../data/challenges';

const difficultyLabel: Record<Challenge['difficulty'], string> = {
  easy: '简单',
  medium: '中等',
  hard: '困难',
};

const counts = {
  easy: challenges.filter((c) => c.difficulty === 'easy').length,
  medium: challenges.filter((c) => c.difficulty === 'medium').length,
  hard: challenges.filter((c) => c.difficulty === 'hard').length,
};

const difficulties = ['easy', 'medium', 'hard'] as const;
---

<Layout title="历史题目" description="每日一题历史存档">
  <Nav />

  <main id="main-content" class="interactive-page challenge-archive-page" data-pagefind-ignore>
    <header class="site-container interactive-header">
      <p class="eyebrow"><span>04 / DAILY CHALLENGE</span><span>ARCHIVE</span></p>
      <div>
        <h1>回看题目，<br /><em>看见积累。</em></h1>
        <div class="challenge-header-side">
          <p>全部 {challenges.length} 道题按难度归档。回到做过的题，再写一次，往往比刷一道新题更有收获。</p>
          <nav aria-label="历史题目辅助导航">
            <a href="/challenge">今日题目</a>
            <a href="/challenge/leaderboard">排行榜</a>
          </nav>
        </div>
      </div>
    </header>

    <section class="site-container challenge-archive-content" aria-labelledby="challenge-list-title">
      <div class="challenge-stats" aria-label="题目难度统计">
        {difficulties.map((diff) => (
          <div data-difficulty={diff}>
            <span>{difficultyLabel[diff]}</span>
            <strong>{String(counts[diff]).padStart(2, '0')}</strong>
            <small>PROBLEMS</small>
          </div>
        ))}
      </div>

      <div class="challenge-list-heading">
        <div>
          <span>PROBLEM INDEX</span>
          <h2 id="challenge-list-title">题目目录</h2>
        </div>
        <p>{challenges.length} ENTRIES / CONTINUOUSLY UPDATED</p>
      </div>

      <div class="challenge-card-grid">
        {challenges.map((challenge, index) => (
          <a href={`/challenge?id=${challenge.id}`} class="challenge-archive-card" data-difficulty={challenge.difficulty}>
            <div class="challenge-card-meta">
              <span>{String(index + 1).padStart(2, '0')} / #{challenge.id}</span>
              <span>{difficultyLabel[challenge.difficulty]}</span>
            </div>
            <h3>{challenge.title}</h3>
            <div class="challenge-card-tags">
              {challenge.tags.slice(0, 3).map((tag) => (
                <span>{tag}</span>
              ))}
              {challenge.tags.length > 3 && <span>+{challenge.tags.length - 3}</span>}
            </div>
            <strong>打开题目 <span aria-hidden="true">↗</span></strong>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
