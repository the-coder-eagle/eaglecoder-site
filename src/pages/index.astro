---
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';

const allPosts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const posts = allPosts.slice(0, 3);

const allProjects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
const projects = allProjects.filter((project) => project.data.featured).slice(0, 3);
const docs = await getCollection('docs');

const stats = [
  { value: String(allPosts.length).padStart(2, '0'), label: '篇公开文章' },
  { value: String(allProjects.length).padStart(2, '0'), label: '个项目记录' },
  { value: String(docs.length).padStart(2, '0'), label: '份学习文档' },
];
---

<Layout title="首页" description="EagleCoder 的个人技术花园：记录软件工程学习、项目实践与方法沉淀。">
  <Nav />

  <main id="main-content">
    <section class="home-hero">
      <div class="site-container hero-grid">
        <div class="hero-copy fade-in">
          <p class="eyebrow"><span>南京大学 · 软件工程</span><span>个人技术花园</span></p>
          <h1>把学习变成<br /><em>可以检索的作品。</em></h1>
          <p class="hero-intro">
            我是 EagleCoder。这里收纳代码实践、项目复盘与仍在生长的想法——先把问题讲清楚，再把答案做出来。
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/posts">开始阅读 <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="/projects">浏览项目 <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <aside class="hero-aside fade-in" aria-label="站点简介">
          <div class="hero-portrait">
            <span class="portrait-index">EC / 001</span>
            <img src="/eagle-hero-v2.png" width="1024" height="1536" alt="被花朵环绕的娘化白头海雕水彩插画" />
            <span class="portrait-caption">CURIOUS BY DEFAULT</span>
          </div>
          <p><span>当前坐标</span>南京</p>
          <p><span>关注主题</span>软件工程 / AI / Web</p>
        </aside>
      </div>

      <div class="site-container hero-stats" aria-label="站点内容统计">
        {stats.map((stat) => (
          <div><strong>{stat.value}</strong><span>{stat.label}</span></div>
        ))}
        <p>最后更新由内容本身决定，<br />不为日更而日更。</p>
      </div>
    </section>

    <section class="site-container home-section">
      <div class="section-heading">
        <div><span>01 / NOTES</span><h2>最近写下</h2></div>
        <a href="/posts">全部文章 <span aria-hidden="true">→</span></a>
      </div>

      {posts.length > 0 ? (
        <div class="article-list">
          {posts.map((post, index) => (
            <a class="article-row" href={`/posts/${post.id}`}>
              <span class="article-number">{String(index + 1).padStart(2, '0')}</span>
              <div class="article-copy">
                <div class="article-meta">
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {post.data.publishedAt.toISOString().slice(0, 10)}
                  </time>
                  {post.data.tags?.slice(0, 2).map((tag) => <span>{tag}</span>)}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <span class="article-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">第一篇文章正在路上。</p>
      )}
    </section>

    <section class="project-band">
      <div class="site-container home-section">
        <div class="section-heading light">
          <div><span>02 / BUILDS</span><h2>选择、构建、复盘</h2></div>
          <a href="/projects">项目档案 <span aria-hidden="true">→</span></a>
        </div>

        {projects.length > 0 ? (
          <div class="project-grid">
            {projects.map((project, index) => (
              <article class="project-card">
                <div class="project-card-top">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{project.data.tech.slice(0, 2).join(' + ')}</span>
                </div>
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                <a href={`/projects/${project.id}`}>阅读项目记录 <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-state dark">项目记录正在整理。</p>
        )}
      </div>
    </section>

    <section class="site-container start-section">
      <p class="eyebrow"><span>03 / START HERE</span></p>
      <div>
        <h2>从一份文档，<br />或一道题开始。</h2>
        <p>知识不必一次学完。选一个足够小的问题，留下能复用的答案。</p>
      </div>
      <div class="start-links">
        <a href="/docs"><span>学习文档</span><strong>整理过的方法与参考</strong><b aria-hidden="true">→</b></a>
        <a href="/challenge"><span>每日一题</span><strong>用代码保持手感</strong><b aria-hidden="true">→</b></a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
