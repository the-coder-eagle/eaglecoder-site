---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Nav from '../../components/Nav.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
---

<Layout title="项目" description="EagleCoder 的项目作品与构建记录">
  <Nav />

  <main id="main-content" class="archive-page">
    <header class="site-container archive-header">
      <p class="eyebrow"><span>02 / BUILDS</span><span>{projects.length} PROJECTS</span></p>
      <div class="archive-title-row">
        <h1>项目与<br /><em>构建记录</em></h1>
        <p>每个项目都是一次选择：解决什么问题，接受哪些约束，又从失败里带走什么。</p>
      </div>
    </header>

    <section class="site-container archive-content" aria-labelledby="project-list-title">
      <div class="filter-bar">
        <h2 id="project-list-title">项目档案</h2>
        <p>按最近整理顺序</p>
      </div>

      {projects.length > 0 ? (
        <div class="archive-project-grid">
          {projects.map((project, index) => (
            <ProjectCard
              index={String(index + 1).padStart(2, '0')}
              href={`/projects/${project.id}`}
              title={project.data.title}
              description={project.data.description}
              tech={project.data.tech}
              github={project.data.github}
              demo={project.data.demo}
              image={project.data.image}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">项目记录正在整理。</p>
      )}
    </section>
  </main>

  <Footer />
</Layout>
