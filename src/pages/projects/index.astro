---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Nav from '../../components/Nav.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
---

<Layout title="项目" description="EagleCoder 的项目作品与构建记录">
  <Nav />

  <main id="main-content" class="archive-page">
    <PageIntro title="项目" description="放在这里的，都是动手做过的东西。点进去看看代码、过程和遇到的问题。" label="工作台 · 项目" scene={3}></PageIntro>

    <section class="site-container archive-content" aria-labelledby="project-list-title">
      <div class="filter-bar">
        <h2 id="project-list-title">项目档案</h2>
        <p>按最近整理顺序</p>
      </div>

      {projects.length > 0 ? (
        <div class="archive-project-grid">
          {projects.map((project, index) => (
            <ProjectCard
              index={String(index + 1).padStart(2, '0')}
              href={`/projects/${project.id}`}
              title={project.data.title}
              description={project.data.description}
              tech={project.data.tech}
              github={project.data.github}
              demo={project.data.demo}
              image={project.data.image}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">项目记录正在整理。</p>
      )}
    </section>
  </main>

  <Footer />
</Layout>
