---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Nav from '../../components/Nav.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const tagCounts = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1));
});
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<Layout title="文章" description="EagleCoder 的技术文章与学习复盘">
  <Nav />

  <main id="main-content" class="archive-page">
    <header class="site-container archive-header">
      <p class="eyebrow"><span>01 / NOTES</span><span>{posts.length} ENTRIES</span></p>
      <div class="archive-title-row">
        <h1>文章与<br /><em>学习复盘</em></h1>
        <p>记录为什么这样做、哪里出了错，以及下次可以复用的方法。</p>
      </div>
    </header>

    <section class="site-container archive-content" aria-labelledby="post-list-title">
      <div class="filter-bar">
        <h2 id="post-list-title">全部文章</h2>
        {tags.length > 0 && (
          <div id="tag-filters" class="tag-filters" aria-label="按标签筛选文章">
            <button class="tag-filter active" type="button" data-tag="" aria-pressed="true">
              全部 <span>{posts.length}</span>
            </button>
            {tags.map(([tag, count]) => (
              <button class="tag-filter" type="button" data-tag={tag} aria-pressed="false">
                {tag} <span>{count}</span>
              </button>
            ))}
          </div>
        )}
      </div>

      <div id="posts-grid" class="article-list">
        {posts.map((post, index) => (
          <a class="article-row post-card" href={`/posts/${post.id}`} data-tags={post.data.tags.join(',')}>
            <span class="article-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="article-copy">
              <div class="article-meta">
                <time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toISOString().slice(0, 10)}</time>
                {post.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <span class="article-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

      <p id="no-posts-msg" class="empty-state" hidden>这个标签下还没有文章。</p>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  function setupTagFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-filter');
    const cards = document.querySelectorAll<HTMLElement>('.post-card');
    const emptyMessage = document.querySelector<HTMLElement>('#no-posts-msg');
    if (!buttons.length || !cards.length) return;

    const applyFilter = (tag: string) => {
      let visibleCount = 0;

      cards.forEach((card) => {
        const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
        const matches = !tag || tags.includes(tag);
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      buttons.forEach((button) => {
        const isActive = (button.dataset.tag ?? '') === tag;
        button.classList.toggle('active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });

      if (emptyMessage) emptyMessage.hidden = visibleCount > 0;

      const url = new URL(window.location.href);
      tag ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag');
      window.history.replaceState({}, '', url);
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => applyFilter(button.dataset.tag ?? ''));
    });

    applyFilter(new URLSearchParams(window.location.search).get('tag') ?? '');
  }

  setupTagFilter();
</script>
