---
import { getCollection, render } from 'astro:content';
import Giscus from '../../components/Giscus.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.filter((post) => !post.data.draft).map((post) => ({ params: { slug: post.id } }));
}

const post = (await getCollection('posts')).find((entry) => entry.id === Astro.params.slug)!;
const { Content } = await render(post);

const meta = [
  `发布于 ${post.data.publishedAt.toISOString().slice(0, 10)}`,
  ...(post.data.updatedAt ? [`更新于 ${post.data.updatedAt.toISOString().slice(0, 10)}`] : []),
  ...(post.data.readingTime ? [`约 ${post.data.readingTime} 分钟`] : []),
];
---

<ContentLayout
  title={post.data.title}
  description={post.data.description}
  eyebrow="ARTICLE / FIELD NOTE"
  backHref="/posts"
  backLabel="返回文章"
  meta={meta}
  tags={post.data.tags}
  tagBase="/posts"
  type="article"
>
  <div class="prose fade-in"><Content /></div>
  <Giscus term="pathname" />
</ContentLayout>
