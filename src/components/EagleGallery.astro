---
import type { EagleGalleryItem } from '../data/eagle-gallery';

interface Props { items: EagleGalleryItem[]; }
const { items } = Astro.props;
---
<section class="site-container journal-album" aria-labelledby="album-title" data-pagefind-ignore>
  <div class="journal-album-head">
    <div><h2 id="album-title">代码之外的小相册</h2><p>小鹰也会出门、喝茶、看星星。<br />这些水彩插画，是这个网站的小小陪伴。</p></div>
    <div class="journal-album-preview" aria-hidden="true">
      {items.slice(15, 18).map(item => <img src={item.src} width="960" height="960" alt="" loading="lazy" decoding="async" />)}
    </div>
  </div>
  <details>
    <summary>翻开全部 {items.length} 张插画</summary>
    <div class="journal-album-grid">
      {items.map(item => <figure><img src={item.src} width="960" height="960" alt={item.alt} loading="lazy" decoding="async" /><figcaption>{item.title}</figcaption></figure>)}
    </div>
  </details>
</section>
