---
// LanguageSelector — 编程语言切换标签
import { LANGUAGES, type SupportedLanguage } from '../../data/challenges';

export interface Props {
  active: SupportedLanguage;
}

const { active } = Astro.props;
---

<div class="language-selector" aria-label="选择编程语言">
  <span>语言</span>
  {LANGUAGES.map((lang) => (
    <button
      type="button"
      class:list={['lang-btn', { active: lang.value === active }]}
      data-lang={lang.value}
      aria-pressed={lang.value === active}
    >
      {lang.label}
    </button>
  ))}
</div>

<script>
  const buttons = document.querySelectorAll('.lang-btn');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      if (!lang) return;

      buttons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');

      // 切换编辑器语言
      (window as any).__editorSwitchLang?.(lang);
      (window as any).__editorCurrentLang = lang;

      // 切换模板代码
      const templates = (window as any).__challengeTemplates;
      if (templates && templates[lang]) {
        (window as any).__editorSetCode?.(templates[lang]);
      }
    });
  });
</script>
