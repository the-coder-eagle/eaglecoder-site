---
import { isNavigationItemActive, primaryNavigation } from '../config/navigation';

const pathname = Astro.url.pathname;
---

<a class="skip-link" href="#main-content">跳到正文</a>

<header class="site-header">
  <nav class="site-container nav-shell" aria-label="主导航">
    <a class="brand" href="/" aria-label="EagleCoder 首页">
      <span class="brand-mark" aria-hidden="true">
        <img src="/avatar-128.png" width="42" height="42" alt="" />
      </span>
      <span>
        <strong>EagleCoder</strong>
        <small>LEARN · BUILD · WRITE</small>
      </span>
    </a>

    <div class="desktop-navigation" aria-label="站点栏目">
      {primaryNavigation.map((item) => {
        const isActive = isNavigationItemActive(pathname, item.href);
        return (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive, accent: item.accent }]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span>{item.index}</span>{item.label}
          </a>
        );
      })}
    </div>

    <div class="nav-actions">
      <button id="search-toggle" class="icon-button" type="button" aria-label="搜索站内内容">
        <span aria-hidden="true">⌕</span>
      </button>
      <button id="theme-toggle" class="icon-button" type="button" aria-label="切换明暗主题">
        <span class="theme-light" aria-hidden="true">☀</span>
        <span class="theme-dark" aria-hidden="true">◐</span>
      </button>
      <button
        id="menu-toggle"
        class="icon-button menu-toggle"
        type="button"
        aria-label="打开导航菜单"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="menu-open" aria-hidden="true">☰</span>
        <span class="menu-close" aria-hidden="true">×</span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-navigation" hidden>
    <div class="site-container mobile-navigation-inner">
      {primaryNavigation.map((item) => {
        const isActive = isNavigationItemActive(pathname, item.href);
        return (
          <a
            href={item.href}
            class:list={['mobile-menu-link', { active: isActive, accent: item.accent }]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span>{item.index}</span>
            <strong>{item.label}</strong>
          </a>
        );
      })}
    </div>
  </div>
</header>

<script>
  function setupNavigation() {
    const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
    const menu = document.querySelector<HTMLElement>('#mobile-menu');

    if (!toggle || !menu) return;

    const closeMenu = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '打开导航菜单');
    };

    toggle.addEventListener('click', () => {
      const willOpen = menu.hidden;
      menu.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', String(willOpen));
      toggle.setAttribute('aria-label', willOpen ? '关闭导航菜单' : '打开导航菜单');
    });

    menu.querySelectorAll('.mobile-menu-link').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  setupNavigation();

  document.querySelector('#search-toggle')?.addEventListener('click', () => {
    (window as Window & { __openSearch?: () => void }).__openSearch?.();
  });

  document.querySelector('#theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  });
</script>
