<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

<div
  id="search-dialog"
  class="search-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-title"
  hidden
>
  <button id="search-backdrop" class="search-backdrop" type="button" aria-label="关闭搜索"></button>

  <section class="search-panel">
    <header class="search-panel-header">
      <div>
        <span>GLOBAL SEARCH / CTRL K</span>
        <h2 id="search-title">搜索这座技术花园</h2>
      </div>
      <button id="search-close" type="button" aria-label="关闭搜索">×</button>
    </header>

    <p class="search-intro">输入标题、标签或正文关键词，结果会在本地索引中即时出现。</p>
    <div id="pagefind-search" class="search-results"></div>
    <footer><span>↑↓ 浏览结果</span><span>ESC 关闭</span></footer>
  </section>
</div>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script>
  const dialog = document.querySelector<HTMLElement>('#search-dialog');
  const backdrop = document.querySelector<HTMLButtonElement>('#search-backdrop');
  const closeButton = document.querySelector<HTMLButtonElement>('#search-close');
  const container = document.querySelector<HTMLElement>('#pagefind-search');

  if (dialog && backdrop && closeButton && container) {
    let initialized = false;
    let previousFocus: HTMLElement | null = null;

    const initSearch = () => {
      if (initialized) return;
      initialized = true;
      try {
        const PagefindUI = (window as Window & { PagefindUI?: new (options: object) => object }).PagefindUI;
        if (!PagefindUI) throw new Error('PagefindUI 尚未加载');
        new PagefindUI({
          element: '#pagefind-search',
          baseUrl: '/',
          showImages: false,
          showSubResults: true,
        });
      } catch {
        container.innerHTML = '<p class="search-error">搜索加载失败，请稍后重试。</p>';
      }
    };

    const openSearch = () => {
      previousFocus = document.activeElement as HTMLElement | null;
      dialog.hidden = false;
      document.body.classList.add('search-open');
      initSearch();
      window.setTimeout(() => container.querySelector<HTMLInputElement>('input')?.focus(), 100);
    };

    const closeSearch = () => {
      dialog.hidden = true;
      document.body.classList.remove('search-open');
      previousFocus?.focus();
    };

    backdrop.addEventListener('click', closeSearch);
    closeButton.addEventListener('click', closeSearch);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !dialog.hidden) closeSearch();
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        dialog.hidden ? openSearch() : closeSearch();
      }
    });

    (window as Window & { __openSearch?: () => void }).__openSearch = openSearch;
  }
</script>
