---
export interface Props {
  index?: string;
  href?: string;
  title: string;
  description: string;
  tech?: string[];
  github?: string;
  demo?: string;
  image?: string;
}

const { index = '01', href, title, description, tech = [], github, demo, image } = Astro.props;
---

<article class="archive-project-card fade-in">
  <div class="archive-project-meta">
    <span>{index}</span>
    {tech.length > 0 && <span>{tech.slice(0, 3).join(' / ')}</span>}
  </div>

  {image && <img src={image} alt="" loading="lazy" />}

  <div class="archive-project-copy">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>

  <div class="archive-project-links">
    {href && <a class="primary" href={href}>项目记录 <span aria-hidden="true">↗</span></a>}
    {github && <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>}
    {demo && <a href={demo} target="_blank" rel="noopener noreferrer">演示</a>}
  </div>
</article>
